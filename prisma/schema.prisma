// =============================================================
// PAINEL DE GESTÃO — esquema do banco (PostgreSQL)
//
// Princípios:
// - Pessoas, clientes, cargos e serviços são CADASTROS únicos, referenciados
//   por chave estrangeira (nada de nome digitado repetido em cada tabela).
// - Datas são datas de verdade (DATE / TIMESTAMP em UTC), dinheiro é DECIMAL,
//   horas do banco de horas são minutos inteiros.
// - Tudo que pode ser calculado NÃO é armazenado: dias de férias, saldo atual,
//   colaboradores ativos por cargo, OS ativas, risco de SLA, tempo restante.
// =============================================================

generator client {
  provider   = "prisma-client-js"
  // Cliente sem engine Rust: consultas vão pelo driver "pg" (src/db.js).
  // Imagem de deploy menor e sem binário nativo para baixar em runtime.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// CADASTROS
// ---------------------------------------------------------------

model Cliente {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique
  documento String?  // CNPJ/CPF
  contato   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contratos Contrato[]
  ordens    OrdemServico[]
  faturas   Fatura[]
  notas     NotaFiscal[]
  chamados  Chamado[]

  @@map("clientes")
}

model Cargo {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  nivel        String
  servico      String? // serviço do contrato a que o cargo pertence
  cbo          String? // Classificação Brasileira de Ocupações (ex.: 3172-10)
  equipeMinima Int?    @map("equipe_minima") // quantidade mínima exigida no contrato
  salarioBase  Decimal @map("salario_base") @db.Decimal(12, 2)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  colaboradores Colaborador[]

  @@unique([nome, nivel])
  @@map("cargos")
}

model Colaborador {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String
  email           String?  @unique
  matricula       String?  @unique
  login           String?  @unique // login de rede
  cargoId         String? @db.Uuid @map("cargo_id")
  funcao          String?
  setor           String? // lotação
  ramal           String?
  celular         String?
  nascimento      DateTime? @db.Date
  formacao        String? // curso / formação acadêmica
  homeOffice      String?  @map("home_office") // Sim | Não
  situacaoVaga    String?  @map("situacao_vaga")
  disponibilidade String   @default("Disponível")
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cargo        Cargo?         @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  ferias       Ferias[]
  afastamentos Afastamento[]
  bancoHoras   BancoHoras[]
  equipamentos Equipamento[]
  ordens       OrdemServico[]
  chamados     Chamado[]
  usuario      Usuario? // conta de acesso ao painel, se houver

  @@index([nome])
  @@index([cargoId])
  @@map("colaboradores")
}

model Servico {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique
  categoria String
  slaHoras  Int      @map("sla_horas")
  preco     Decimal  @db.Decimal(12, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ordens   OrdemServico[]
  chamados Chamado[]

  @@map("servicos")
}

// ---------------------------------------------------------------
// GESTÃO DE PESSOAS
// ---------------------------------------------------------------

model Ferias {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorId String @db.Uuid @map("colaborador_id")
  inicio        DateTime @db.Date
  fim           DateTime @db.Date
  status        String   @default("Pendente")
  observacao    String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId])
  @@index([inicio])
  @@map("ferias")
}

model Afastamento {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorId String @db.Uuid @map("colaborador_id")
  tipo          String
  inicio        DateTime  @db.Date
  fim           DateTime? @db.Date
  status        String    @default("Em andamento")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId])
  @@map("afastamentos")
}

model BancoHoras {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorId    String @db.Uuid @map("colaborador_id")
  competencia      DateTime @db.Date // sempre o dia 1 do mês de referência
  saldoAnteriorMin Int      @default(0) @map("saldo_anterior_min")
  movimentacaoMin  Int      @default(0) @map("movimentacao_min")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, competencia])
  @@map("banco_horas")
}

model Equipamento {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descricao     String
  patrimonio    String    @unique
  responsavelId String? @db.Uuid @map("responsavel_id")
  entrega       DateTime? @db.Date
  devolucao     DateTime? @db.Date
  status        String    @default("Disponível")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  responsavel Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([responsavelId])
  @@map("equipamentos")
}

model Contratacao {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidato String
  vaga      String
  etapa     String
  previsao  DateTime? @db.Date
  status    String    @default("Em andamento")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("contratacoes")
}

model Contrato {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero      String    @unique
  clienteId   String @db.Uuid @map("cliente_id")
  escopo      String
  vigenciaFim DateTime  @map("vigencia_fim") @db.Date
  status      String    @default("Em execução")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@map("contratos")
}

// Kanban genérico: um "quadro" (ex.: "pessoas") com colunas e cards ordenados.
model KanbanColuna {
  id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quadro String
  titulo String
  ordem  Int

  cards KanbanCard[]

  @@unique([quadro, ordem])
  @@map("kanban_colunas")
}

model KanbanCard {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colunaId  String @db.Uuid @map("coluna_id")
  titulo    String
  etiqueta  String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coluna KanbanColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)

  @@index([colunaId, ordem])
  @@map("kanban_cards")
}

// ---------------------------------------------------------------
// ORDENS DE SERVIÇO E FINANCEIRO
// ---------------------------------------------------------------

model OrdemServico {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero        String    @unique
  clienteId     String @db.Uuid @map("cliente_id")
  servicoId     String? @db.Uuid @map("servico_id")
  responsavelId String? @db.Uuid @map("responsavel_id")
  descricao     String?
  prazo         DateTime  @db.Date
  status        String    @default("Aberta")
  concluidaEm   DateTime? @map("concluida_em")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico     Servico?     @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  responsavel Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  faturas     Fatura[]

  @@index([clienteId])
  @@index([responsavelId])
  @@index([status])
  @@map("ordens_servico")
}

model Fatura {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String @db.Uuid @map("cliente_id")
  ordemId    String? @db.Uuid @map("ordem_id")
  referencia String?
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime  @db.Date
  status     String    @default("Em aberto")
  pagoEm     DateTime? @map("pago_em") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  cliente Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ordem   OrdemServico? @relation(fields: [ordemId], references: [id], onDelete: SetNull)
  notas   NotaFiscal[]

  @@index([clienteId])
  @@index([vencimento])
  @@map("faturas")
}

model NotaFiscal {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero    String   @unique
  clienteId String @db.Uuid @map("cliente_id")
  faturaId  String? @db.Uuid @map("fatura_id")
  valor     Decimal  @db.Decimal(12, 2)
  emissao   DateTime @db.Date
  status    String   @default("Emitida")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fatura  Fatura? @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@map("notas_fiscais")
}

// ---------------------------------------------------------------
// SLA
// ---------------------------------------------------------------

// O risco (No prazo / Atenção / Crítico / Atrasado) e o tempo restante são
// calculados a partir de prazoEm e concluidoEm — nunca digitados.
model Chamado {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String    @unique
  clienteId     String @db.Uuid @map("cliente_id")
  servicoId     String? @db.Uuid @map("servico_id")
  responsavelId String? @db.Uuid @map("responsavel_id")
  descricao     String?
  abertoEm      DateTime  @default(now()) @map("aberto_em")
  prazoEm       DateTime  @map("prazo_em")
  concluidoEm   DateTime? @map("concluido_em")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico     Servico?     @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  responsavel Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([prazoEm])
  @@index([responsavelId])
  @@index([concluidoEm])
  @@map("chamados")
}

// ---------------------------------------------------------------
// GERAL
// ---------------------------------------------------------------

model Evento {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo    String
  inicio    DateTime
  modulo    String?  // pessoas | os | sla (opcional, para colorir)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([inicio])
  @@map("eventos")
}

// ---------------------------------------------------------------
// ACESSO (login, aprovação e permissões por tela)
// ---------------------------------------------------------------

model Usuario {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  email         String    @unique // sempre minúsculo
  senhaHash     String    @map("senha_hash") // scrypt: salt:hash (hex)
  papel         String    @default("usuario") // admin | usuario
  status        String    @default("pendente") // convidado | pendente | ativo | bloqueado
  // Acesso por tela: se tiver perfil, vale o do perfil; senão, vale `acessos`.
  // Formato: { "chave-da-tela": "ver" | "editar" } (tela ausente = sem acesso)
  perfilId      String? @db.Uuid @map("perfil_id")
  acessos       Json      @default("{}")
  colaboradorId String? @unique @db.Uuid @map("colaborador_id")
  // Link de convite / redefinição de senha: só o SHA-256 do token fica no banco
  conviteHash   String?   @unique @map("convite_hash")
  conviteExpira DateTime? @map("convite_expira")
  ultimoAcesso  DateTime? @map("ultimo_acesso")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  perfil      Perfil?      @relation(fields: [perfilId], references: [id], onDelete: SetNull)
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  sessoes     Sessao[]
  atividades  Atividade[]

  @@index([perfilId])
  @@map("usuarios")
}

// Modelo de acesso reutilizável (ex.: "RH", "Financeiro").
model Perfil {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique
  descricao String?
  acessos   Json     @default("{}") // mesmo formato de Usuario.acessos
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]

  @@map("perfis")
}

model Sessao {
  id        String   @id // SHA-256 do token do cookie (o token em si não é guardado)
  usuarioId String @db.Uuid @map("usuario_id")
  expiraEm  DateTime @map("expira_em")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

// Configurações gerais editáveis pelo admin (nome do painel, cor, cadastro público…).
model Configuracao {
  chave String @id
  valor Json

  @@map("configuracoes")
}

// Histórico de quem criou/alterou/excluiu o quê.
model Atividade {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String? @db.Uuid @map("usuario_id")
  acao      String // criou | alterou | excluiu | moveu | admin
  tela      String? // chave do módulo
  descricao String
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("atividades")
}
